# Everything works without these. The semantic judge falls back to a deterministic mock.
# To use a real model instead, install requirements-llm.txt and set both:
JUDGE_MODEL=anthropic/claude-haiku-5-5
ANTHROPIC_API_KEY=
# Any LiteLLM-supported provider works, e.g. JUDGE_MODEL=openai/gpt-4o-mini with OPENAI_API_KEY.

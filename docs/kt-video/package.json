{
  "name": "grader-audit-kt-video",
  "private": true,
  "type": "module",
  "description": "Build scripts for the Grader Audit KT video. Not part of the application.",
  "scripts": {
    "kt-video": "npm run facts && npm run tts && node render.mjs",
    "facts": ".venv/Scripts/python facts.py",
    "tts": ".venv/Scripts/python tts.py",
    "render": "node render.mjs",
    "preview": "node render.mjs --preview",
    "qa": "node render.mjs --qa"
  },
  "devDependencies": {
    "@fontsource/inter": "5.1.1",
    "@fontsource/jetbrains-mono": "5.1.2",
    "@fontsource/space-grotesk": "5.1.1",
    "playwright": "1.57.0"
  }
}

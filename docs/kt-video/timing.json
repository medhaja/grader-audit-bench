   "sentences": [
    {
     "text": "Here's a benchmark task.",
     "start": 0.0,
     "end": 2.05
    },
    {
     "text": "How many orders have a null customer ID?",
     "start": 2.17,
     "end": 5.195
    },
    {
     "text": "The answer is seven.",
     "start": 5.315,
     "end": 7.215
    },
    {
     "text": "A scripted agent answers seventeen, and the naive grader passes it, because seven appears inside seventeen.",
     "start": 7.335,
     "end": 14.835
    },
    {
     "text": "Public reports, like O-S World issue five eighteen, describe exactly this.",
     "start": 14.955,
     "end": 20.38
    },
    {
     "text": "When the grader is wrong, the score measures the grader, not the agent.",
     "start": 20.5,
     "end": 24.85
    }

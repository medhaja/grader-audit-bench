   "title": "Grade the grader",
   "label": "02 / The idea",
   "start": 25.45,
   "speech": 27.17,
   "end": 53.22,
   "sentences": [
    {
     "text": "This prototype grades the grader, without running a model.",
     "start": 25.45,
     "end": 29.175
    },
    {
     "text": "Twelve synthetic data-engineering tasks each get eight scripted probe outputs.",
     "start": 29.295,
     "end": 34.345
    },
    {
     "text": "Gold, paraphrase, no-op, substring trap, a fake that only looks done, and more.",
     "start": 34.465,
     "end": 39.89
    },
    {
     "text": "All ninety-six cases have a known label.",
     "start": 40.01,
     "end": 43.135
    },
    {
     "text": "A false positive passes a case that should fail.",
     "start": 43.255,
     "end": 46.48
    },
    {
     "text": "A false negative fails one that should pass.",
     "start": 46.6,
     "end": 49.675
    },
    {
     "text": "A flaky verdict changes between runs.",
     "start": 49.795,
     "end": 52.62

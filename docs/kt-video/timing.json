   "sentences": [
    {
     "text": "It's a straight pipeline.",
     "start": 53.22,
     "end": 55.12
    },
    {
     "text": "Tasks dot py generates twelve tasks from one fixed seed.",
     "start": 55.24,
     "end": 59.365
    },
    {
     "text": "Probes dot py adds eight labeled outputs per task, and generate dot py writes them to the data folder.",
     "start": 59.485,
     "end": 66.635
    },
    {
     "text": "Runner dot py grades every case five times per grader, then writes results and a report.",
     "start": 66.755,
     "end": 72.855
    },
    {
     "text": "Serve dot py, a Fast A-P-I app, serves them to one static page.",
     "start": 72.975,
     "end": 77.95
    }
   ],
